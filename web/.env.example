# Try-on provider: "openai" (default) or "gemini".
BILLY_TRYON_PROVIDER=openai

OPENAI_API_KEY=
BILLY_OPENAI_MODEL=gpt-image-2
# low | medium | high. Medium takes about 25s per look.
BILLY_OPENAI_QUALITY=medium

GEMINI_API_KEY=
BILLY_GEMINI_MODEL=gemini-3.1-flash-image

# Try-ons allowed per IP per hour (in-memory, per server instance).
BILLY_RATE_LIMIT_PER_HOUR=40
