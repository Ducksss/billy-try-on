{
  "name": "billy",
  "private": true,
  "description": "Billy: virtual try-on Chrome extension and web app for pre-loved and surplus clothing.",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "assets": "node scripts/generate-assets.mjs",
    "looks": "node scripts/generate-looks.mjs",
    "pack:extension": "node scripts/pack-extension.mjs --server https://billy-try-on.vercel.app",
    "test:extension": "node tests/extension.e2e.mjs",
    "pack:extension:local": "node scripts/pack-extension.mjs",
    "deploy": "npm run pack:extension && vercel deploy --prod"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
